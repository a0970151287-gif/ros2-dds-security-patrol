* text=auto

# WSL / ROS2 executables and configuration must keep Unix line endings.
*.sh    text eol=lf
*.py    text eol=lf
*.zeek  text eol=lf
*.xml   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.launch text eol=lf

# Keep source and documentation diffs consistent across Windows and WSL.
*.c     text eol=lf
*.cc    text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
