{
  "schema_version": "sros2-firewall-identity-attribution-contract/v1",
  "status": "blocked",
  "purpose": "development-only RTPS/DDS identity features and future trusted identity-to-IP attribution",
  "observation_schema": "sros2-firewall-rtps-identity-observation/v1",
  "required_artifacts": [
    "rtps_identity.jsonl",
    "identity_attestation.json",
    "dds_security_audit.jsonl"
  ],
  "required_zeek_identity_fields": [
    "rtps_guid_prefix",
    "rtps_entity_id",
    "dds_topic",
    "dds_identity_subject_sha256"
  ],
  "feature_names": [
    "rtps_participant_rate",
    "rtps_guid_churn_rate",
    "rtps_guid_multi_ip_ratio",
    "rtps_ip_multi_guid_ratio",
    "rtps_endpoint_rate",
    "rtps_topic_diversity_ratio",
    "rtps_acl_deny_ratio",
    "rtps_authenticated_binding_ratio",
    "rtps_complete_evidence_ratio"
  ],
  "lineage_bindings": [
    "session_id",
    "capture_sha256",
    "decoder_sha256",
    "policy_sha256",
    "collector_id",
    "sequence",
    "ts_unix_ns"
  ],
  "network_action_acceptance": {
    "unique_guid_to_ip_binding": true,
    "ip_not_shared_by_multiple_identities": true,
    "authenticated_identity_subject_binding": true,
